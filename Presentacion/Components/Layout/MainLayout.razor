@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-secondary">Panel de gestión</span>
            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <span class="fw-semibold text-primary">👋 Hola, @(context.User.Identity?.Name ?? "Usuario")</span>
                        <form method="post" action="/auth/logout" class="d-inline">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar Sesión</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-sm btn-outline-primary">Ingresar</a>
                        <a href="/registro" class="btn btn-sm btn-primary">Registrarse</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
