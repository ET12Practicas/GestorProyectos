@page "/"
@rendermode InteractiveServer
@inject IProyectoService ProyectoService
@inject ITicketService TicketService
@inject IUsuarioService UsuarioService
@inject IComentarioService ComentarioService
@inject ICurrentUserService CurrentUserService

<PageTitle>Resumen - Gestor de Proyectos</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-heading">
            <div>
                <span class="eyebrow">DASHBOARD</span>
                <h1>¡Hola, @(context.User.Identity?.Name ?? "Bienvenido")!</h1>
                <p>Este es el estado actual de tus proyectos y tareas asignadas.</p>
            </div>
            <button class="btn btn-outline-primary" @onclick="CargarAsync">↻ Actualizar</button>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        else if (_cargando)
        {
            <div class="text-center my-5 py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-secondary mt-3">Cargando métricas...</p>
            </div>
        }
        else
        {
            <div class="metric-grid">
                <a class="metric-card" href="proyectos">
                    <span>Mis Proyectos</span>
                    <strong>@_proyectos</strong>
                    <small>proyectos activos</small>
                </a>
                <a class="metric-card" href="tickets">
                    <span>Mis Tickets</span>
                    <strong>@_tickets</strong>
                    <small>@_ticketsAbiertos abiertos</small>
                </a>
                <a class="metric-card" href="usuarios">
                    <span>Compañeros</span>
                    <strong>@_usuarios</strong>
                    <small>usuarios en el sistema</small>
                </a>
                <a class="metric-card" href="comentarios">
                    <span>Aportes</span>
                    <strong>@_comentarios</strong>
                    <small>comentarios</small>
                </a>
            </div>

            <section class="content-card mt-4">
                <h2>Rendimiento y Progreso</h2>
                <div class="progress mt-3" style="height: 14px;" role="progressbar" aria-label="Tickets cerrados" aria-valuenow="@PorcentajeCerrados" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" style="width: @(PorcentajeCerrados)%">@PorcentajeCerrados%</div>
                </div>
                <p class="text-secondary mt-2 mb-0">@_ticketsCerrados de @_tickets tickets completados.</p>
            </section>
        }
    </Authorized>
    <NotAuthorized>
        <div class="content-card text-center my-5 py-5" style="border-radius: 18px;">
            <span class="display-3">🚀</span>
            <h1 class="mt-3 mb-2 fw-bold">Bienvenido al Gestor de Proyectos</h1>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 500px;">
                Organiza tus equipos, crea proyectos privados, gestiona tableros Kanban estilo Trello y asigna tickets en tiempo real.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/login" class="btn btn-primary px-4 py-2">Iniciar Sesión</a>
                <a href="/registro" class="btn btn-outline-primary px-4 py-2">Crear Cuenta</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _cargando;
    private string? _error;
    private int _proyectos;
    private int _tickets;
    private int _ticketsAbiertos;
    private int _ticketsCerrados;
    private int _usuarios;
    private int _comentarios;

    private int PorcentajeCerrados =>
        _tickets == 0 ? 0 : (int)Math.Round(_ticketsCerrados * 100d / _tickets);

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        if (!CurrentUserService.UsuarioId.HasValue) return;

        _cargando = true;
        _error = null;

        try
        {
            var misProyectos = await ProyectoService.ObtenerProyectosDelUsuarioAsync(CurrentUserService.UsuarioId.Value);
            var todosLosTickets = new List<TicketQueryDto>();
            foreach (var p in misProyectos)
            {
                var ticketsDelProyecto = await TicketService.ObtenerTicketsPorProyectoAsync(p.Id);
                todosLosTickets.AddRange(ticketsDelProyecto);
            }

            var usuarios = await UsuarioService.ObtenerUsuariosAsync();
            var comentarios = await ComentarioService.ObtenerComentariosAsync();

            _proyectos = misProyectos.Count;
            _tickets = todosLosTickets.Count;
            _ticketsAbiertos = todosLosTickets.Count(t => t.Estado == EEstadoTicket.Abierto || t.Estado == EEstadoTicket.EnProgreso);
            _ticketsCerrados = todosLosTickets.Count(t => t.Estado == EEstadoTicket.Cerrado);
            _usuarios = usuarios.Count;
            _comentarios = comentarios.Count;
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar la información: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }
}
