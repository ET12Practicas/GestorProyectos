@page "/usuarios"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]
@inject IUsuarioService UsuarioService
@inject ICurrentUserService CurrentUserService

<PageTitle>Usuarios</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">EQUIPO</span>
        <h1>Usuarios</h1>
        <p>Administrá las personas que pueden participar en los proyectos.</p>
    </div>
</div>

@if (_mensaje is not null)
{
    <div class="alert @(_esError ? "alert-danger" : "alert-success")" role="alert">@_mensaje</div>
}

<div class="row g-4">
    <div class="col-12">
        <section class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Personas</h2>
                <span class="count-pill">@_usuarios.Count usuarios</span>
            </div>

            @if (_cargando)
            {
                <p><em>Cargando usuarios...</em></p>
            }
            else if (_usuarios.Count == 0)
            {
                <div class="empty-state">No hay usuarios registrados.</div>
            }
            else
            {
                <div class="user-list">
                    @foreach (var usuario in _usuarios)
                    {
                        <div class="user-row d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar">@Inicial(usuario.Nombre)</div>
                                <div>
                                    <strong>@usuario.Nombre</strong>
                                    <div><small class="text-secondary">@usuario.Id</small></div>
                                </div>
                            </div>

                            @if (CurrentUserService.UsuarioId != usuario.Id)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => SolicitarEliminar(usuario)">
                                    Eliminar
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>

@if (_mostrarModalConfirmarEliminar)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Eliminar usuario</h5>
                    <button type="button" class="btn-close" @onclick="() => _mostrarModalConfirmarEliminar = false"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-secondary mb-3">
                        ¿Estás seguro de que deseas eliminar a <strong>@_usuarioAEliminar?.Nombre</strong> del sistema?<br />
                        Esta acción es permanente y no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" @onclick="() => _mostrarModalConfirmarEliminar = false">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminarAsync">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<UsuarioQueryDto> _usuarios = [];

    private bool _cargando;
    private bool _esError;
    private string? _mensaje;
    private bool _mostrarModalConfirmarEliminar;
    private UsuarioQueryDto? _usuarioAEliminar;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;

        try
        {
            _usuarios = await UsuarioService.ObtenerUsuariosAsync();
        }
        catch (Exception ex)
        {
            Mostrar($"No se pudieron cargar los usuarios: {ex.Message}", true);
        }
        finally
        {
            _cargando = false;
        }
    }

    private void SolicitarEliminar(UsuarioQueryDto usuario)
    {
        _usuarioAEliminar = usuario;
        _mostrarModalConfirmarEliminar = true;
    }

    private async Task ConfirmarEliminarAsync()
    {
        if (_usuarioAEliminar is null) return;

        var idAEliminar = _usuarioAEliminar.Id;
        _mostrarModalConfirmarEliminar = false;
        _usuarioAEliminar = null;

        await EliminarAsync(idAEliminar);
    }

    private async Task EliminarAsync(Guid usuarioId)
    {
        var result = await UsuarioService.EliminarUsuarioAsync(usuarioId);
        if (result.IsSuccess)
        {
            Mostrar("Usuario eliminado exitosamente.", false);
            await CargarAsync();
        }
        else
        {
            Mostrar(result.Error.Mensaje, true);
        }
    }

    private void Mostrar(string mensaje, bool error)
    {
        _mensaje = mensaje;
        _esError = error;
    }

    private static string Inicial(string nombre) =>
        string.IsNullOrWhiteSpace(nombre) ? "?" : nombre[..1].ToUpperInvariant();
}
