@page "/proyectos"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IProyectoService ProyectoService
@inject ITicketService TicketService
@inject IUsuarioService UsuarioService
@inject ICurrentUserService CurrentUserService

<PageTitle>Mis Proyectos - Gestor de Proyectos</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">WORKSPACE</span>
        <h1>Mis Proyectos</h1>
        <p>Proyectos creados por vos y proyectos a los que fuiste invitado.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" @onclick="CargarAsync">↻ Actualizar</button>
        <button class="btn btn-primary" @onclick="() => _mostrarModalProyecto = true">+ Nuevo Proyecto</button>
    </div>
</div>

@if (_mensaje is not null)
{
    <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @_mensaje
        <button type="button" class="btn-close" @onclick="() => _mensaje = null"></button>
    </div>
}

@if (_cargando)
{
    <div class="text-center my-5 py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-secondary mt-3">Cargando proyectos...</p>
    </div>
}
else if (_proyectos.Count == 0)
{
    <div class="empty-state my-5 py-5">
        <span class="display-4">📂</span>
        <h3 class="mt-3">No tenés proyectos asignados todavía</h3>
        <p class="text-secondary">Creá tu primer proyecto o pedile al creador de un equipo que te invite.</p>
        <button class="btn btn-primary mt-2" @onclick="() => _mostrarModalProyecto = true">Crear Proyecto</button>
    </div>
}
else
{
    <div class="project-grid">
        @foreach (var proyecto in _proyectos)
        {
            var esCreador = EsCreadorDelProyecto(proyecto);
            var ticketsCerrados = proyecto.Tickets.Count(t => t.Estado == EEstadoTicket.Cerrado);
            var totalTickets = proyecto.Tickets.Count;
            var porcentaje = totalTickets == 0 ? 0 : (int)Math.Round((double)ticketsCerrados * 100 / totalTickets);

            <article class="content-card project-card d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <span class="project-role-badge @(esCreador ? "role-owner" : "role-member")">
                            @(esCreador ? "Dueño" : "Invitado")
                        </span>
                        <span class="count-pill">@totalTickets tickets</span>
                    </div>

                    <h2 class="mb-2 fs-4 fw-bold">@proyecto.Nombre</h2>
                    <p class="text-secondary small mb-3">
                        Creador: <strong>@(proyecto.Creador?.Nombre ?? "Sistema")</strong>
                    </p>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between small text-secondary mb-1">
                            <span>Progreso</span>
                            <span>@porcentaje%</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: @(porcentaje)%"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small fw-semibold">EQUIPO (@proyecto.Usuarios.Count)</span>
                            @if (esCreador)
                            {
                                <button class="btn btn-sm btn-link p-0 text-decoration-none" @onclick="() => AbrirModalSumarUsuario(proyecto)">
                                    + Invitar
                                </button>
                            }



                        </div>
                        @if (proyecto.Usuarios.Count == 0)
                        {
                            <span class="text-muted small">Sin miembros aún.</span>
                        }



                        else
                        {
                            <div class="chip-list">
                                @foreach (var usuario in proyecto.Usuarios)
                                {
                                    <span class="person-chip">
                                        @usuario.Nombre
                                        @if (esCreador && usuario.Id != CurrentUserService.UsuarioId.GetValueOrDefault())
                                        {
                                            <button class="btn btn-sm btn-outline-danger ms-1"
                                                    @onclick="() => AbrirModalEliminarUsuario(proyecto, usuario)"
                                                    title="Eliminar del proyecto">✕</button>
                                        }


                                    </span>
                                }



                            </div>
                        }



                    </div>
                </div>

                <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center">
                    <a href="tickets?proyectoId=@proyecto.Id" class="btn btn-outline-primary btn-sm px-3">
                        Ver Tablero Kanban →
                    </a>
                    @if (esCreador)
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarProyectoAsync(proyecto.Id)">
                            Eliminar
                        </button>
                    }



                </div>
            </article>
        }



    </div>
}

@* Modal para Crear Proyecto *@
@if (_mostrarModalProyecto)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nuevo Proyecto</h5>
                    <button type="button" class="btn-close" @onclick="() => _mostrarModalProyecto = false"></button>
                </div>
                <EditForm Model="_nuevoProyecto" OnValidSubmit="CrearProyectoAsync">
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del Proyecto</label>
                            <InputText class="form-control py-2" placeholder="Ej: Rediseño Web, Módulo Pagos..." @bind-Value="_nuevoProyecto.Nombre" required autofocus />
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light" @onclick="() => _mostrarModalProyecto = false">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4">Crear Proyecto</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* Modal para Invitar / Sumar Usuario a Proyecto *@
@if (_mostrarModalUsuario && _proyectoSeleccionado is not null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Invitar al Proyecto</h5>
                    <button type="button" class="btn-close" @onclick="() => _mostrarModalUsuario = false"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-secondary small mb-3">
                        Buscá a un usuario por su dirección de email para sumarlo a <strong>@_proyectoSeleccionado.Nombre</strong>.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email del usuario</label>
                        <div class="input-group">
                            <input type="email" class="form-control" placeholder="ejemplo@correo.com"
                                   @bind="_emailParaBuscar" @bind:event="oninput"
                                   @onkeydown="@(async e => { if (e.Key == "Enter") await BuscarUsuarioPorEmailAsync(); })" />
                            <button class="btn btn-outline-primary" type="button" @onclick="BuscarUsuarioPorEmailAsync" disabled="@_buscandoUsuario">
                                @if (_buscandoUsuario)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    <span>Buscar</span>
                                }
                            </button>
                        </div>
                    </div>

                    @if (_mensajeBusqueda is not null)
                    {
                        <div class="alert alert-info py-2 small mb-3">@_mensajeBusqueda</div>
                    }

                    @if (_usuarioEncontrado is not null)
                    {
                        <div class="alert alert-success d-flex align-items-center justify-content-between py-2 mb-0">
                            <div>
                                <strong>Encontrado:</strong> @_usuarioEncontrado.Nombre
                            </div>
                            <span class="badge bg-success">Listo para invitar</span>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" @onclick="() => _mostrarModalUsuario = false">Cancelar</button>
                    <button type="button" class="btn btn-primary px-4" @onclick="AsignarUsuarioAsync" disabled="@(_usuarioEncontrado is null)">Invitar al Proyecto</button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal para confirmar eliminación de usuario del proyecto *@
@if (_mostrarModalEliminarUsuario)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Eliminar usuario del proyecto</h5>
                    <button type="button" class="btn-close" @onclick="() => _mostrarModalEliminarUsuario = false"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-secondary mb-3">
                        ¿Estás seguro de que deseas remover a <strong>@_usuarioSeleccionado?.Nombre</strong> del proyecto <strong>@_proyectoParaEliminarUsuario?.Nombre</strong>?<br />
                        Esta acción no eliminará al usuario del sistema, solo lo desvinculará del proyecto.
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" @onclick="() => _mostrarModalEliminarUsuario = false">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminarUsuarioAsync">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<ProyectoQueryDto> _proyectos = [];
    private ProyectoCommandDto _nuevoProyecto = new() { Nombre = string.Empty };
    
    private bool _cargando;
    private bool _esError;
    private string? _mensaje;
    
    private bool _mostrarModalProyecto;
    private bool _mostrarModalUsuario;
    private bool _mostrarModalEliminarUsuario;
    private ProyectoQueryDto? _proyectoParaEliminarUsuario;
    private UsuarioQueryDto? _usuarioSeleccionado;
    private ProyectoQueryDto? _proyectoSeleccionado;
    private string _emailParaBuscar = string.Empty;
    private bool _buscandoUsuario;
    private UsuarioQueryDto? _usuarioEncontrado;
    private string? _mensajeBusqueda;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;

        try
        {
            var usuarioId = CurrentUserService.UsuarioId;
            if (usuarioId.HasValue)
            {
                // Regla de privacidad: solo traemos los proyectos del usuario autenticado (creados o invitado)
                _proyectos = await ProyectoService.ObtenerProyectosDelUsuarioAsync(usuarioId.Value);
            }
            else
            {
                _proyectos = [];
            }
        }
        catch (Exception ex)
        {
            Mostrar($"No se pudieron cargar los proyectos: {ex.Message}", true);
        }
        finally
        {
            _cargando = false;
        }
    }

    private bool EsCreadorDelProyecto(ProyectoQueryDto proyecto)
    {
        return CurrentUserService.UsuarioId.HasValue && proyecto.CreadorId == CurrentUserService.UsuarioId.Value;
    }

    private async Task CrearProyectoAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevoProyecto.Nombre)) return;

        var result = await ProyectoService.CrearProyectoAsync(_nuevoProyecto);
        if (result.IsSuccess)
        {
            Mostrar("Proyecto creado exitosamente.", false);
            _nuevoProyecto = new ProyectoCommandDto { Nombre = string.Empty };
            _mostrarModalProyecto = false;
            await CargarAsync();
        }



        else
        {
            Mostrar(result.Error.Mensaje, true);
        }



    }




    private void AbrirModalSumarUsuario(ProyectoQueryDto proyecto)
    {
        _proyectoSeleccionado = proyecto;
        _emailParaBuscar = string.Empty;
        _usuarioEncontrado = null;
        _mensajeBusqueda = null;
        _mostrarModalUsuario = true;
    }

    private async Task BuscarUsuarioPorEmailAsync()
    {
        if (string.IsNullOrWhiteSpace(_emailParaBuscar))
        {
            _mensajeBusqueda = "Ingresá un email para buscar.";
            _usuarioEncontrado = null;
            return;
        }

        _buscandoUsuario = true;
        _mensajeBusqueda = null;
        _usuarioEncontrado = null;

        try
        {
            var encontrado = await UsuarioService.ObtenerUsuarioPorEmailAsync(_emailParaBuscar.Trim());
            if (encontrado is null)
            {
                _mensajeBusqueda = "No se encontró ningún usuario con ese email.";
            }
            else if (_proyectoSeleccionado is not null && _proyectoSeleccionado.Usuarios.Any(u => u.Id == encontrado.Id))
            {
                _mensajeBusqueda = $"'{encontrado.Nombre}' ya forma parte de este proyecto.";
            }
            else
            {
                _usuarioEncontrado = encontrado;
            }
        }
        catch (Exception ex)
        {
            _mensajeBusqueda = $"Error al buscar: {ex.Message}";
        }
        finally
        {
            _buscandoUsuario = false;
        }
    }

    // Open the delete‑user confirmation modal (owner only)
    private void AbrirModalEliminarUsuario(ProyectoQueryDto proyecto, UsuarioQueryDto usuario)
    {
        _proyectoParaEliminarUsuario = proyecto;
        _usuarioSeleccionado = usuario;
        _mostrarModalEliminarUsuario = true;
    }

    // Called from the modal to actually remove the user from the project
    private async Task ConfirmarEliminarUsuarioAsync()
    {
        if (_proyectoParaEliminarUsuario == null || _usuarioSeleccionado == null)
        {
            Mostrar("Datos insuficientes para eliminar usuario.", true);
            return;
        }
        var result = await ProyectoService.QuitarUsuarioDeProyectoAsync(_proyectoParaEliminarUsuario.Id, _usuarioSeleccionado.Id);
        if (result.IsSuccess)
        {
            Mostrar($"Usuario '{_usuarioSeleccionado.Nombre}' removido del proyecto.", false);
            _mostrarModalEliminarUsuario = false;
            await CargarAsync();
        }
        else
        {
            Mostrar(result.Error.Mensaje, true);
        }
    }

    private async Task AsignarUsuarioAsync()
    {
        if (_proyectoSeleccionado is null || _usuarioEncontrado is null)
        {
            Mostrar("Buscá y seleccioná un usuario válido.", true);
            return;
        }

        var result = await ProyectoService.AsignarUsuarioAProyectoAsync(_proyectoSeleccionado.Id, _usuarioEncontrado.Id);
        if (result.IsSuccess)
        {
            Mostrar($"'{_usuarioEncontrado.Nombre}' fue sumado al equipo del proyecto.", false);
            _mostrarModalUsuario = false;
            _usuarioEncontrado = null;
            _emailParaBuscar = string.Empty;
            await CargarAsync();
        }
        else
        {
            Mostrar(result.Error.Mensaje, true);
        }
    }




    private async Task EliminarProyectoAsync(Guid proyectoId)
    {
        var result = await ProyectoService.EliminarProyectoAsync(proyectoId);
        if (result.IsSuccess)
        {
            Mostrar("Proyecto eliminado.", false);
            await CargarAsync();
        }



        else
        {
            Mostrar(result.Error.Mensaje, true);
        }



    }




    private void Mostrar(string mensaje, bool error)
    {
        _mensaje = mensaje;
        _esError = error;
    }



}
