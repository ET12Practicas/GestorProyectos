@page "/tickets"
@rendermode InteractiveServer
@inject ITicketService TicketService
@inject IProyectoService ProyectoService

<PageTitle>Tickets</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">SEGUIMIENTO</span>
        <h1>Tickets</h1>
        <p>Asigná responsables, actualizá estados y mantené el tablero al día.</p>
    </div>
    <button class="btn btn-outline-primary" @onclick="Cargar">Actualizar</button>
</div>

@if (_mensaje is not null)
{
    <div class="alert @(_esError ? "alert-danger" : "alert-success")" role="alert">@_mensaje</div>
}

@if (_cargando)
{
    <p><em>Cargando tickets...</em></p>
}
else if (_tickets.Count == 0)
{
    <div class="empty-state">No hay tickets registrados.</div>
}
else
{
    <section class="content-card table-responsive">
        <div class="mb-4">
            <h2 class="mb-1">Asignación de responsables</h2>
            <p class="text-secondary mb-0">
                Cada ticket sólo puede asignarse a usuarios que pertenezcan a su proyecto.
            </p>
        </div>

        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Ticket</th>
                    <th>Proyecto</th>
                    <th>Responsable</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in _tickets)
                {
                    var usuarios = UsuariosDelTicket(ticket.Id);

                    <tr>
                        <td class="fw-semibold">@ticket.Nombre</td>
                        <td>@NombreProyecto(ticket.Id)</td>
                        <td>
                            <select class="form-select form-select-sm responsable-select"
                                    value="@(ticket.Usuario?.Id.ToString() ?? string.Empty)"
                                    disabled="@(usuarios.Count == 0)"
                                    aria-label="Responsable de @ticket.Nombre"
                                    @onchange="args => AsignarUsuario(ticket.Id, args.Value?.ToString())">
                                @if (usuarios.Count == 0)
                                {
                                    <option value="">Sin usuarios en el proyecto</option>
                                }
                                else
                                {
                                    <option value="" disabled>Seleccionar responsable...</option>
                                    @foreach (var usuario in usuarios)
                                    {
                                        <option value="@usuario.Id">@usuario.Nombre</option>
                                    }
                                }
                            </select>
                        </td>
                        <td>@ticket.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>
                            <select class="form-select form-select-sm status-select"
                                    value="@ticket.Estado"
                                    aria-label="Estado de @ticket.Nombre"
                                    @onchange="args => CambiarEstado(ticket.Id, args.Value?.ToString())">
                                @foreach (var estado in Enum.GetValues<EEstadoTicket>())
                                {
                                    <option value="@estado">@TextoEstado(estado)</option>
                                }
                            </select>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(ticket.Id)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private IReadOnlyList<TicketQueryDto> _tickets = [];
    private IReadOnlyList<ProyectoQueryDto> _proyectos = [];
    private bool _cargando;
    private bool _esError;
    private string? _mensaje;

    protected override void OnInitialized() => Cargar();

    private void Cargar()
    {
        _cargando = true;

        try
        {
            _tickets = TicketService.ObtenerTickets();
            _proyectos = ProyectoService.ObtenerProyectos();
        }
        catch (Exception ex)
        {
            Mostrar($"No se pudieron cargar los tickets: {ex.Message}", true);
        }
        finally
        {
            _cargando = false;
        }
    }

    private IReadOnlyList<UsuarioQueryDto> UsuariosDelTicket(Guid ticketId) =>
        ProyectoDelTicket(ticketId)?.Usuarios ?? [];

    private string NombreProyecto(Guid ticketId) =>
        ProyectoDelTicket(ticketId)?.Nombre ?? "Sin proyecto";

    private ProyectoQueryDto? ProyectoDelTicket(Guid ticketId) =>
        _proyectos.FirstOrDefault(proyecto =>
            proyecto.Tickets.Any(ticket => ticket.Id == ticketId));

    private void AsignarUsuario(Guid ticketId, string? valor)
    {
        if (!Guid.TryParse(valor, out var usuarioId))
        {
            Mostrar("Seleccioná un usuario válido.", true);
            return;
        }

        Ejecutar(
            () => ProyectoService.AsignarUsuarioATicket(ticketId, usuarioId),
            "Responsable asignado.",
            "El usuario debe pertenecer al mismo proyecto que el ticket.");
    }

    private void CambiarEstado(Guid ticketId, string? valor)
    {
        if (!Enum.TryParse<EEstadoTicket>(valor, out var estado))
        {
            Mostrar("El estado seleccionado no es válido.", true);
            return;
        }

        Ejecutar(
            () => ProyectoService.CambiarEstadoTicket(
                ticketId,
                new EstadoTicketDto { Estado = estado }),
            "Estado actualizado.",
            "No se pudo actualizar el estado.");
    }

    private void Eliminar(Guid ticketId) => Ejecutar(
        () => ProyectoService.EliminarTicket(ticketId),
        "Ticket eliminado.",
        "No se encontró el ticket.");

    private void Ejecutar(Func<bool> accion, string mensajeOk, string mensajeError)
    {
        try
        {
            var correcto = accion();
            Mostrar(correcto ? mensajeOk : mensajeError, !correcto);

            if (correcto)
            {
                Cargar();
            }
        }
        catch (Exception ex)
        {
            Mostrar($"La operación falló: {ex.Message}", true);
        }
    }

    private void Mostrar(string mensaje, bool error)
    {
        _mensaje = mensaje;
        _esError = error;
    }

    private static string TextoEstado(EEstadoTicket estado) => estado switch
    {
        EEstadoTicket.EnProgreso => "En progreso",
        _ => estado.ToString()
    };
}
